# Anselm Gateway — environment template
# 复制为 .env 本地跑(.env 已 gitignore);生产由 systemd EnvironmentFile 注入。
# ⚠️ 绝不把真实机密提交进库。

# 配置三类:① 运行时可改项(下方多数项;后台可在线改、存 DB、热生效——env 仅给初始
#   默认,加载顺序 env 默认 ← DB 覆盖);② 机密(DASHSCOPE_API_KEY /
#   DASHBOARD_USER/PASSWORD:env only,绝不入 DB,dump 只掩码);③ 启动期硬约束(模型 / base URL /
#   内存预算项 / 监听 / tz / DB 路径:
#   env only,改需重启,后台只读)。

# === 上游机密 ===
# **必填。** 每一条路由都去 Qwen,故没有它的网关什么也服务不了——启动即 fail-fast,好过对每个
# 请求都答一次故障。支持逗号分隔多 key(key 池是一个账号扛过单 key 冷却的方式)。
# 可用新加坡 Workspace ID 自动构造端点。API Key 是机密;Workspace ID 不是机密,但部署时同样
# 应由环境注入。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxx
# 仅在非标准 DashScope compatible endpoint 时显式覆盖；否则保持空，由 Workspace ID 推导。
DASHSCOPE_BASE_URL=

# === 管理后台监听（env only、启动期硬约束、后台不可改）===
# 后台**恒定挂载**,且**恒定只绑 loopback**——绑定 fail-fast,故「外部可达」不是本进程到得了的
# 状态。鉴权**不由本进程负责**:登录墙归前面那道 IAP(Cloudflare Access / Tailscale / SSH 隧道)。
# 绝不要把 8081 直接反代或暴露出去。必须与 LISTEN_ADDR / ADMIN_ADDR 三者互不相同,冲突则启动期
# 指名 fail-fast(否则运行期某个 listener 绑不上)。
DASHBOARD_ADDR=127.0.0.1:8081

# === 模型面 ===
# 客户端只看到一个逻辑 model id(可热改);它**永远不选** provider——请求里的 model 字段是别名,
# 不是选择器。文本与媒体走同一个上游模型,故只有一个真实 model id,且它必须有精确费率卡。
# 真实 model id 是启动期硬约束,改后需重启。
PUBLIC_MODEL_ID=anselm-auto
MULTIMODAL_UPSTREAM_MODEL=qwen3.7-plus

# === 配额 / 预算护栏 ===
# 🔴 所有运行时可改数值项都有「下界 + 合理上界」(per-spec 天花板,env 与后台 DB overlay
#   两路共用):越界(防 OOM 的海量字符/消息、绕护栏的天文数字预算/cap)启动期或后台改时
#   fail-fast 指名报错。
#
# 🔴 GATEWAY_MODE 统管本段所有配额旋钮,故排在最前——它重新解释下面每一行。
#   debug(默认):把**配给用户**的闸全部掩开(月额度、operator 钱包、令牌桶、日子限、
#     品类日闸、领号闸、PoW),让运营者开发客户端时不被自家护栏挡住。
#   production:按下面配置的数值执行。
#   掩码是**派生**的、绝不破坏原值:配置值仍留在后台编辑并持久化的那份 Config 上,切回
#   production 逐字节恢复、无需重填。这正是它做成「模式」而不是「把十几个旋钮手动改成 0」
#   的理由——后者一用就丢掉了生产值。
#   ⚠️ 两个方向都危险,故拼错立即 fail-fast:"prod" 静默当成 debug = 公网网关门户大开。
#   ⚠️ 记账不受影响:两种模式下 reserve/settle 照跑、spend_ledger 照记每一 pUSD。
#      debug 是「永不拒绝」,不是「永不记账」。
GATEWAY_MODE=debug
MONTHLY_QUOTA=5000
# 花费单位是 microUSD(1,000,000 = US$1),入账前按各 provider 的精确模型费率换算。
# 两个请求闸门:每 install 月请求数 + operator 全局月花费。
# 旧 daily/provider/installer 花费表只继续记录统计,不再作为拒绝条件。
GLOBAL_MONTHLY_SPEND_MICRO_USD=420000000
# 输出产品 cap。INPUT_TOKEN_CAP 仅为旧 settings/env 兼容保留，不参与准入；
# prompt estimate 只用于账务 quote，provider 才判定真实 input hard limit。
MAX_TOKENS_CAP=4096
INPUT_TOKEN_CAP=0
# SEC-1 深层输入护栏:messages 数组元素数上限 + 单条 content 字符数上限(rune 计)。
MAX_MESSAGES=256
MAX_MESSAGE_CHARS=131072
# inline media 护栏:整段 messages 最多 8 个媒体 part,所有 base64 解码后合计最多 3MiB。
# 8MiB body 用于容纳 3MiB 媒体经 base64 膨胀后的 4MiB、长工具历史与 JSON 余量;
# 必须有 MAX_MEDIA_DECODED_BYTES <= MAX_BODY_BYTES。
MAX_BODY_BYTES=8388608
MAX_MEDIA_PARTS=8
MAX_MEDIA_DECODED_BYTES=3145728

# === 生成能力(图 / 语音 / 视频)——显式 opt-in,默认全关 ===
# Three separate capabilities, deliberately not one switch: an operator may want
# images and not video, and they bill in different units (images / characters /
# seconds). All three share DASHSCOPE_API_KEY and the NATIVE DashScope origin.
# Enabling one requires its credential, its compiled rate card, and that origin,
# or startup fails — a route that can only answer 503 is worse than no route.
# 三个各自独立的能力,刻意不做成一个开关:运营者可能只要图不要视频,且计费单位不同
# (张 / 字符 / 秒)。三者共用 DASHSCOPE_API_KEY 与**原生** DashScope origin。开启任一项
# 都要求凭证 + 已编译费率卡 + 该 origin,否则启动 fail-fast——一条只能答 503 的路由不如没有。
IMAGE_ENABLED=false
IMAGE_UPSTREAM_MODEL=qwen-image-2.0
# 逐 install 每日出图张数上限。0 = 关闭该闸(仍然记账审计)。
IMAGE_DAILY_LIMIT=10
SPEECH_ENABLED=false
TTS_UPSTREAM_MODEL=qwen-audio-3.0-tts-flash
# 默认音色属于**模型**、不属于产品:qwen-audio-3.0 的音色名带 `_v3.6` 后缀,且它直接拒绝
# 上一代的名字。这里留一个过期值不是外观问题——每一次省略 voice 的合成都会在上游失败。
TTS_DEFAULT_VOICE=longanhuan_v3.6
# 逐 install 每日合成**字符**数上限(按 rune 计,一个汉字算一个)。0 = 关闭该闸。
SPEECH_DAILY_LIMIT=50000
VIDEO_ENABLED=false
VIDEO_UPSTREAM_MODEL=wan2.7-t2v
VIDEO_I2V_UPSTREAM_MODEL=wan2.7-i2v-2026-04-25
# 逐 install 每日**条**数上限——计费按秒报价,但人心里配给的是整条片子,故品类账本与钱账本
# 在此刻意数不同的单位。视频是本网关能被要求做的最贵的事,一条 5 秒片比一整天的图还贵。
VIDEO_DAILY_LIMIT=10
# 逐 install 每日音色**登记**次数上限。默认 2 = 库存大小。这是与无界花费之间唯一站着的东西:
# 库存上限界的是**持有**几个,而删除会腾位,故 enroll→delete 循环在没有这道闸时可以无限烧钱
# (每圈真花 $0.2)。0 = 关闭。
VOICE_DAILY_LIMIT=2
# 账号级克隆音色总数上限。这是**库存、不是日限额**:没有东西会重置它,一个音色占着位直到有人
# 删掉。0 = 不强制,也是默认——provider 没有文档写出真实上限;从一次拒绝里学到之后再填。
VOICE_ACCOUNT_CEILING=0
# NATIVE DashScope API origin (multimodal-generation), distinct from the
# compatible-mode DASHSCOPE_BASE_URL. LEAVE IT EMPTY: the default derives the
# origin from the credential's own host, and pinning a region here is exactly how
# a Singapore workspace key ends up answering 401 against the Beijing endpoint —
# the same key, 200 in one region and 401 in the other. Set it only to reach a
# non-standard origin.
# 原生 DashScope API origin,与 compatible-mode 的 DASHSCOPE_BASE_URL 不同。**留空**:
# 默认值从凭证自己的 host 派生,而在这里钉死一个区域,正是新加坡 workspace key 对着北京
# 端点答 401 的原因——同一把 key,一个区域 200、另一个 401。只有要打非标准 origin 才填。
DASHSCOPE_NATIVE_BASE=

# === 媒体暂存(startup-hard;显式 opt-in)===
# 原始媒体从不进入 chat JSON。开启后客户端把 proof 绑定的、可续传的分片上传到网关,
# 之后只有一个不透明的短期 lease 进入模型流量。staging 放在持久化的私有数据卷上
# (不要 /tmp,绝不要 web root)。签名机密是必需的:重启后要能重建 provider 取件凭证,
# 而不必落盘明文 bearer token。
MEDIA_ENABLED=false
MEDIA_STAGING_ROOT=anselm-media
MEDIA_SIGNING_SECRET=
# 整个对象的上限;单个 PUT 分片还必须同时装得下 MAX_BODY_BYTES。
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_CHUNK_MAX_BYTES=4194304
# 未完成的上传与已完成的 lease 各自独立过期。
MEDIA_UPLOAD_TTL_SEC=3600
MEDIA_LEASE_TTL_SEC=3600

# === 并发 / 速率 ===
# 🔴 两个 provider 共享的全局在飞并发硬上限;N×单流带宽不得打满机器。
N_GLOBAL_CONCURRENCY=8
# 每 install 分钟令牌桶(0=禁用)
RATE_PER_MIN=0
# 每 install 每日次数子限额(0=禁用)
DAILY_SUBLIMIT=0
# /install 单 IP 每小时频控(0=禁用)
INSTALL_PER_IP_HOUR=0
# === M2 防 Sybil 领号闸(全部默认 0=禁用,保持现状;设非 0 才启用)===
# 🔴 0=禁用:默认配置下 /v1/install 行为逐字不变(gate 短路、不进 DB 事务)。三项均
#   运行时可改(后台可在线调阀、存 DB、热生效)。隐私:fingerprint 只以 SHA-256 落
#   install_fp_rate,绝不入库/入日志明文。
# 全局每日领号粗阀(按 Asia/Shanghai 日翻页;0=禁用)。⚠️ 这是「防账目失控的粗阀」,
#   必须远高于真实日活——设太低会把正常新用户锁在门外(非卡日活闸)。触顶返
#   429 INSTALL_CAP_REACHED。
INSTALL_GLOBAL_DAILY_CAP=0
# 同 fingerprint 当日领号上限(0=禁用;fp 为空永远放行,不拿空串当桶键)。触顶返
#   429 INSTALL_FP_LIMITED。
INSTALL_PER_FP_DAILY=0
# 同 fingerprint 相邻领号最小间隔秒(0=禁用)。冷却窗内再领返 429 INSTALL_FP_LIMITED。
INSTALL_PER_FP_COOLDOWN_SEC=0

# === M2 批次3 领号 PoW(proof-of-work)钩子(客户端协同装置;默认 off=dormant)===
# 🔴 默认 off:需 Anselm Flutter app 客户端协同(求解 PoW)后再激活。激活路径(强一致,顺序铁律):
#   ① env 配 INSTALL_POW_SECRET + 重启(secret 进 base Config)→ ② 热改 shadow 观测「带合法 PoW 占比」
#   达标 → ③ 再切 enforce。没配 secret 就切 mode≠off 会被 fail-fast 挡(CONFIG_POW_SECRET_REQUIRED)。
# 三态(reviewer B3,非 bool——消除「后台一键热开即锁死所有老客户端」脚枪):
#   off:     完全不验(dormant,零影响;默认配置下 /v1/install 行为逐字不变,验证整段短路)。
#   shadow:  带 X-PoW 则验,失败只告警+放行(不拒);不带也放行——灰度观测占比,不破坏存量客户端。
#   enforce: 必须带且验通过,否则 403 INSTALL_POW_REQUIRED / INSTALL_POW_INVALID。
# 客户端 GET /v1/install/challenge 取 {challenge, difficulty, required}(challenge 无状态自验,
#   不建表、不含任何用户数据),求解 SHA256(challenge.nonce) 前导 DIFFICULTY bit 为 0,回
#   X-PoW: <challenge>.<nonce>。required 仅 enforce 时为 true(off/shadow 时 false,客户端不必随开关改代码)。
INSTALL_POW_MODE=off
# 难度 = SHA256(challenge.nonce) 要求的前导零 bit 数(界 [1,32];默认 20≈百万级哈希,数百毫秒客户端 CPU)。
# 运行时可改、热生效。热调高难度后,旧低难度 nonce 被拒。
INSTALL_POW_DIFFICULTY=20
# === PoW challenge HMAC 签名机密(env only,绝不入 DB/Dump/日志,同上游 key 纪律)===
# 🔴 纯显式配置、绝不自动生成(删了旧 auto-secret:避免重启换 secret 失效旧 challenge,且与「热改 mode 时
#   secret 来自 base Config」不变式冲突)。生效 mode∈{shadow,enforce} 时**必须显式配一份非空 SECRET**,否则
#   fail-fast(CONFIG_POW_SECRET_REQUIRED:Load 启动失败 / 后台热改 mode 的 override 被拒)。mode=off(默认)时
#   无关、留空即可(Dump 只报 configured/disabled,绝不出真值)。建议用随机长串(如 openssl rand -hex 32)。
INSTALL_POW_SECRET=

# === M2 批次2 per-token 异常自动降速(可逆、温和、优先于封禁;默认 0=禁用)===
# 🔴 0=禁用:默认配置下 proxy 行为逐字不变(异常 tracker 的 Observe 第一行短路返 false,
#   零开销,现有限流/计费/隐私语义不变)。三项均运行时可改(后台可在线调阀、存 DB、热生效)。
# 机制:per-install 滑动分钟 RPM 超 TOKEN_ANOMALY_RPM → 在 RATE_PER_MIN 同一个令牌桶上把
#   该 install 临时收紧到 RATE_PER_MIN/TOKEN_THROTTLE_FACTOR,持续 TOKEN_THROTTLE_COOLDOWN_SEC
#   秒后自动回归。降速在「同一限流器、该 install 原本的桶」上连续生效(切换瞬间只收紧不放松,
#   攻击者拿不到全新空桶);到期自动可逆。隐私:tracker 只持 opaque installID,绝不持 prompt/
#   token 明文。降速命中记 WARN security_event(只 installID/ip_key)+ 指标
#   gateway_token_throttled_total(进入降速)/ gateway_tokens_throttled(当前降速中 install 数)。
# per-install 异常 RPM 触发点(0=禁用整套自动降速)。
TOKEN_ANOMALY_RPM=0
# 降速倍数:降速期生效限额 = RATE_PER_MIN / 此值(向下取整,最低 1/min)。1=逃生口(不降速,
#   仅记录信号)。仅 TOKEN_ANOMALY_RPM>0 时被读。
TOKEN_THROTTLE_FACTOR=4
# 单次降速持续秒,到期自动回归 RATE_PER_MIN。仅 TOKEN_ANOMALY_RPM>0 时被读。
TOKEN_THROTTLE_COOLDOWN_SEC=300

# 上游 connect→header 阶段超时(秒);只界定建连到首帧前,绝不盖住流式 body。
# 跨 GFW 抖动留余量,默认 60。
UPSTREAM_HEADER_TIMEOUT_SEC=60
# REL-7 过载背压:N_global 满时有界等待窗口(毫秒)。窗口内拿到槽则放行(吸收尖峰),
# 超时返 429 UPSTREAM_BUSY;客户端取消则不占槽。0=退化为二元立即拒。默认 1500。
# 🔴 红线:N_global 仍是账号级硬上限,等待只排队、绝不放大并发。
QUEUE_WAIT_MS=1500

# === 内存预算(PERF-2,2G 机)===
# 🔴 最坏 RSS = GOMEMLIMIT + SQLITE_CACHE×(1+READ_POOL_MAX_CONNS) + SQLITE_MMAP,须
#   < MEM_BUDGET_MIB - MEM_SAFETY_MARGIN_MIB。SQLITE_CACHE 是 per-connection:写池 1 份 +
#   读池 N 份(非「×2」!旧默认会逼近 2G → OOM)。默认 768 + 32×(1+4) + 256 = 1184MiB
#   < 2048-400=1648(见 README 内存预算表)。启动期 config.Load 自检超预算即 fail-fast。
# GOMEMLIMIT 软上限 MiB:堆逼近时 GC 更积极而非被内核 OOM-kill(0=禁用)。
GOMEMLIMIT_MIB=768
# 每连接 SQLite page cache 上限 KiB(写池 1 + 读池 N 各一份;DSN cache_size 取负值=KiB)。
SQLITE_CACHE_KIB=32768
# SQLite mmap 上限 MB(读路径走 mmap 省一次拷贝;0=禁用)。
SQLITE_MMAP_MB=256
# WAL 自动 checkpoint 触发页数(界定 WAL 文件膨胀上界)。
SQLITE_WAL_AUTOCHECKPOINT=4000
# 只读池并发连接上限(匹配 1C 机;每连接一份 cache,故它直接乘进内存预算)。
READ_POOL_MAX_CONNS=4
# 启动期内存预算自检:总预算 MiB(默认按 2GiB 机)+ 必须给 OS/runtime 突发留的安全垫 MiB。
# 最坏 RSS 超过(预算-安全垫)→ fail-fast(防误配 OOM)。GOMEMLIMIT_MIB=0 时降级为 WARN。
MEM_BUDGET_MIB=2048
MEM_SAFETY_MARGIN_MIB=400

# === 磁盘满 / WAL 膨胀防护(REL-6)===
# 数据盘剩余低于阈值(绝对 MiB 或百分比,任一未达即触发)→ 只读降级:新写请求返
# 503 DISK_LOW + 结构化 WARN,而非让 SQLite 静默写失败;盘恢复自动解除。0=禁用对应判定。
DISK_MIN_MB=500
DISK_MIN_PERCENT=5

# === 周期 / 监听 ===
RESET_TZ=Asia/Shanghai
LISTEN_ADDR=127.0.0.1:8080

# === 可观测性 ===
# 日志级别(debug|info|warn|error);slog JSON → stdout(systemd 收 journald)。
LOG_LEVEL=info
# 🔴 /metrics 独立 admin 端口:必须 loopback(127.0.0.1),绝不公网 / 不经 Caddy。
# 非 loopback 值启动期 fail-fast。
ADMIN_ADDR=127.0.0.1:9090
# OBS-4 告警:阈值检测保留(budget/上游熔断/磁盘/错误率),但只在管理后台页面显示当前
# firing 状态 + 最近触发时间,不外推(webhook/Telegram 已弃用)。绝不含 key/prompt/token/ip。

# SQLite 落盘路径(生产置于 ReadWritePaths 内)
GATEWAY_DB_PATH=anselm-gateway.db

# MEDIA_DOMAIN — 上游可以来取 lease 字节的**公开**主机(裸主机名,无 scheme;空=音色登记不可用)。
# **绝不能是 `api.` 前缀那台。** ADR 0012 的生产判别实验:同一个 lease URL 放在 api.<域> 上连续三次
# 400,而 Caddy 访问日志证明源站从未收到请求;同样的字节/路径/token 放普通主机上答 200——拉取器在
# 它自己的边缘把 API 形主机拉黑,不可见、不可申诉。配错会**无形地**失败,故启动时就拒。
# 范围:**只给音色登记用**(voice-enrollment 根本不收 base64)。chat 与图像输入继续内联字节。
MEDIA_DOMAIN=
