# Anselm Free-Tier Gateway — environment template (蓝图 §10.3)
# 复制为 .env 本地跑(.env 已 gitignore);生产由 systemd EnvironmentFile 注入。
# ⚠️ 绝不把真实机密提交进库。

# 配置三类:① 运行时可改项(下方多数项;后台可在线改、存 DB、热生效——env 仅给初始
#   默认,加载顺序 env 默认 ← DB 覆盖);② 机密(DEEPSEEK_API_KEY / DASHBOARD_*:env
#   only,绝不入 DB,dump 只掩码);③ 启动期硬约束(内存预算项 / 监听 / tz / DB 路径:
#   env only,改需重启,后台只读)。

# === 机密一:DeepSeek API key(支持逗号分隔多 key,第一个为主)===
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 机密二:管理后台鉴权(env only,绝不入 DB;要么都配、要么都空,半配启动期
#   fail-fast)。后台 dump 只掩码为「configured」,绝不打印真值。两者都配时进程额外起
#   一个独立 loopback 监听 127.0.0.1:8081(与业务 8080 / admin 9090 物理隔离),除
#   /healthz 外全路由强制鉴权(bcrypt 登录 → 服务端 session cookie → CSRF → 登录限流);
#   Caddy 反代 dashboard.<域名>→DASHBOARD_ADDR。半配(只配其一)启动期 fail-fast;都空则跳过后台。===
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# 后台独立 loopback 监听地址(启动期硬约束,env only,改需重启,后台只读)。必须与
# LISTEN_ADDR / ADMIN_ADDR 互不相同——冲突则启动期指名 fail-fast(否则运行期某 listener 绑不上)。
DASHBOARD_ADDR=127.0.0.1:8081
# ⚠️ 仅 dev:无 Caddy/TLS 的本机 plain-HTTP 登录时,置 true 关掉 session cookie 的 Secure 标志,
#   让 dev 能登录。默认 false=Secure 恒为 true。生产经 Caddy HTTPS,绝不可开(关了 cookie 在明文
#   HTTP 上可被嗅探/注入)。
DASHBOARD_DEV_INSECURE_COOKIE=false

# === 模型白名单(真实 deepseek model id;client 的 model 强制改写到首项)===
# 逗号分隔可声明多个,首项为默认改写目标(线上档示例:deepseek-v4-flash)。
MODEL_ALLOWLIST=deepseek-chat

# === 配额 / 预算护栏 ===
# 🔴 所有运行时可改数值项都有「下界 + 合理上界」(per-spec 天花板,env 与后台 DB overlay
#   两路共用):越界(防 OOM 的海量字符/消息、绕护栏的天文数字预算/cap)启动期或后台改时
#   fail-fast 指名报错。
MONTHLY_QUOTA=5000
# 🔴 每日全局预算(=月预算/30);唯一钱包护栏,据真实单价反推(蓝图 §16 #3)
GLOBAL_DAILY_BUDGET_TOKENS=1000000
# 单 install 每日 token 子配额。🔴 SEC-2 语义校验:① 必须 <= GLOBAL_DAILY_BUDGET_TOKENS
# (否则单个 install 即可独吞全部日预算,子限额名存实亡);② 必须 >= INPUT_TOKEN_CAP +
# MAX_TOKENS_CAP(单请求最坏预占;否则当日首请求都必撞日 cap、该 install 一次都打不通)。
# 任一违反启动期 / 后台改时 fail-fast 指名报错。
INSTALL_DAILY_TOKEN_CAP=50000
# 单请求输出 / 输入 token 上限
MAX_TOKENS_CAP=4096
INPUT_TOKEN_CAP=16384
# SEC-1 深层输入护栏:messages 数组元素数上限 + 单条 content 字符数上限(rune 计)。
# 256KB body + token cap 挡总量,这两道挡「海量 tiny message 放大计费边界」(OWASP API4)
# 与「单巨消息」。超限 400 BAD_REQUEST。
MAX_MESSAGES=256
MAX_MESSAGE_CHARS=131072

# === 并发 / 速率 ===
# 🔴 全局在飞并发(≤ DeepSeek 账号级并发上限;N×单流带宽 ≤ 固定带宽,蓝图 §16 #2/#7)
N_GLOBAL_CONCURRENCY=8
# 每 install 分钟令牌桶
RATE_PER_MIN=20
# 每 install 每日次数子限额(0=禁用)
DAILY_SUBLIMIT=0
# /install 单 IP 每小时频控(持久化)
INSTALL_PER_IP_HOUR=10
# === M2 防 Sybil 领号闸(全部默认 0=禁用,保持现状;设非 0 才启用)===
# 🔴 0=禁用:默认配置下 /v1/install 行为逐字不变(gate 短路、不进 DB 事务)。三项均
#   运行时可改(后台可在线调阀、存 DB、热生效)。隐私:fingerprint 只以 SHA-256 落
#   install_fp_rate,绝不入库/入日志明文。
# 全局每日领号粗阀(按 Asia/Shanghai 日翻页;0=禁用)。⚠️ 这是「防账目失控的粗阀」,
#   必须远高于真实日活——设太低会把正常新用户锁在门外(非卡日活闸)。触顶返
#   429 INSTALL_CAP_REACHED。
INSTALL_GLOBAL_DAILY_CAP=0
# 同 fingerprint 当日领号上限(0=禁用;fp 为空永远放行,不拿空串当桶键)。触顶返
#   429 INSTALL_FP_LIMITED。
INSTALL_PER_FP_DAILY=0
# 同 fingerprint 相邻领号最小间隔秒(0=禁用)。冷却窗内再领返 429 INSTALL_FP_LIMITED。
INSTALL_PER_FP_COOLDOWN_SEC=0

# === M2 批次3 领号 PoW(proof-of-work)钩子(客户端协同装置;默认 off=dormant)===
# 🔴 默认 off:需 Anselm Flutter app 客户端协同(求解 PoW)后再激活。激活路径(强一致,顺序铁律):
#   ① env 配 INSTALL_POW_SECRET + 重启(secret 进 base Config)→ ② 热改 shadow 观测「带合法 PoW 占比」
#   达标 → ③ 再切 enforce。没配 secret 就切 mode≠off 会被 fail-fast 挡(CONFIG_POW_SECRET_REQUIRED)。
# 三态(reviewer B3,非 bool——消除「后台一键热开即锁死所有老客户端」脚枪):
#   off:     完全不验(dormant,零影响;默认配置下 /v1/install 行为逐字不变,验证整段短路)。
#   shadow:  带 X-PoW 则验,失败只告警+放行(不拒);不带也放行——灰度观测占比,不破坏存量客户端。
#   enforce: 必须带且验通过,否则 403 INSTALL_POW_REQUIRED / INSTALL_POW_INVALID。
# 客户端 GET /v1/install/challenge 取 {challenge, difficulty, required}(challenge 无状态自验,
#   不建表、不含任何用户数据),求解 SHA256(challenge.nonce) 前导 DIFFICULTY bit 为 0,回
#   X-PoW: <challenge>.<nonce>。required 仅 enforce 时为 true(off/shadow 时 false,客户端不必随开关改代码)。
INSTALL_POW_MODE=off
# 难度 = SHA256(challenge.nonce) 要求的前导零 bit 数(界 [1,32];默认 20≈百万级哈希,数百毫秒客户端 CPU)。
# 运行时可改、热生效。热调高难度后,旧低难度 nonce 被拒。
INSTALL_POW_DIFFICULTY=20
# === 机密三:PoW challenge HMAC 签名机密(env only,绝不入 DB/Dump/日志,同 DEEPSEEK/DASHBOARD 纪律)===
# 🔴 纯显式配置、绝不自动生成(删了旧 auto-secret:避免重启换 secret 失效旧 challenge,且与「热改 mode 时
#   secret 来自 base Config」不变式冲突)。生效 mode∈{shadow,enforce} 时**必须显式配一份非空 SECRET**,否则
#   fail-fast(CONFIG_POW_SECRET_REQUIRED:Load 启动失败 / 后台热改 mode 的 override 被拒)。mode=off(默认)时
#   无关、留空即可(Dump 只报 configured/disabled,绝不出真值)。建议用随机长串(如 openssl rand -hex 32)。
INSTALL_POW_SECRET=

# === M2 批次2 per-token 异常自动降速(可逆、温和、优先于封禁;默认 0=禁用)===
# 🔴 0=禁用:默认配置下 proxy 行为逐字不变(异常 tracker 的 Observe 第一行短路返 false,
#   零开销,现有限流/计费/隐私语义不变)。三项均运行时可改(后台可在线调阀、存 DB、热生效)。
# 机制:per-install 滑动分钟 RPM 超 TOKEN_ANOMALY_RPM → 在 RATE_PER_MIN 同一个令牌桶上把
#   该 install 临时收紧到 RATE_PER_MIN/TOKEN_THROTTLE_FACTOR,持续 TOKEN_THROTTLE_COOLDOWN_SEC
#   秒后自动回归。降速在「同一限流器、该 install 原本的桶」上连续生效(切换瞬间只收紧不放松,
#   攻击者拿不到全新空桶);到期自动可逆。隐私:tracker 只持 opaque installID,绝不持 prompt/
#   token 明文。降速命中记 WARN security_event(只 installID/ip_key)+ 指标
#   gateway_token_throttled_total(进入降速)/ gateway_tokens_throttled(当前降速中 install 数)。
# per-install 异常 RPM 触发点(0=禁用整套自动降速)。
TOKEN_ANOMALY_RPM=0
# 降速倍数:降速期生效限额 = RATE_PER_MIN / 此值(向下取整,最低 1/min)。1=逃生口(不降速,
#   仅记录信号)。仅 TOKEN_ANOMALY_RPM>0 时被读。
TOKEN_THROTTLE_FACTOR=4
# 单次降速持续秒,到期自动回归 RATE_PER_MIN。仅 TOKEN_ANOMALY_RPM>0 时被读。
TOKEN_THROTTLE_COOLDOWN_SEC=300

# 上游 connect→header 阶段超时(秒);只界定建连到首帧前,绝不盖住流式 body。
# 跨 GFW 抖动留余量,默认 60。
UPSTREAM_HEADER_TIMEOUT_SEC=60
# REL-7 过载背压:N_global 满时有界等待窗口(毫秒)。窗口内拿到槽则放行(吸收尖峰),
# 超时返 429 UPSTREAM_BUSY;客户端取消则不占槽。0=退化为二元立即拒。默认 1500。
# 🔴 红线:N_global 仍是账号级硬上限,等待只排队、绝不放大并发。
QUEUE_WAIT_MS=1500

# === 内存预算(PERF-2,2G 机)===
# 🔴 最坏 RSS = GOMEMLIMIT + SQLITE_CACHE×(1+READ_POOL_MAX_CONNS) + SQLITE_MMAP,须
#   < MEM_BUDGET_MIB - MEM_SAFETY_MARGIN_MIB。SQLITE_CACHE 是 per-connection:写池 1 份 +
#   读池 N 份(非「×2」!旧默认会逼近 2G → OOM)。默认 768 + 32×(1+4) + 256 = 1184MiB
#   < 2048-400=1648(见 README 内存预算表)。启动期 config.Load 自检超预算即 fail-fast。
# GOMEMLIMIT 软上限 MiB:堆逼近时 GC 更积极而非被内核 OOM-kill(0=禁用)。
GOMEMLIMIT_MIB=768
# 每连接 SQLite page cache 上限 KiB(写池 1 + 读池 N 各一份;DSN cache_size 取负值=KiB)。
SQLITE_CACHE_KIB=32768
# SQLite mmap 上限 MB(读路径走 mmap 省一次拷贝;0=禁用)。
SQLITE_MMAP_MB=256
# WAL 自动 checkpoint 触发页数(界定 WAL 文件膨胀上界)。
SQLITE_WAL_AUTOCHECKPOINT=4000
# 只读池并发连接上限(匹配 1C 机;每连接一份 cache,故它直接乘进内存预算)。
READ_POOL_MAX_CONNS=4
# 启动期内存预算自检:总预算 MiB(默认按 2GiB 机)+ 必须给 OS/runtime 突发留的安全垫 MiB。
# 最坏 RSS 超过(预算-安全垫)→ fail-fast(防误配 OOM)。GOMEMLIMIT_MIB=0 时降级为 WARN。
MEM_BUDGET_MIB=2048
MEM_SAFETY_MARGIN_MIB=400

# === 磁盘满 / WAL 膨胀防护(REL-6)===
# 数据盘剩余低于阈值(绝对 MiB 或百分比,任一未达即触发)→ 只读降级:新写请求返
# 503 DISK_LOW + 结构化 WARN,而非让 SQLite 静默写失败;盘恢复自动解除。0=禁用对应判定。
DISK_MIN_MB=500
DISK_MIN_PERCENT=5

# === 周期 / 监听 ===
RESET_TZ=Asia/Shanghai
LISTEN_ADDR=127.0.0.1:8080

# === 可观测性 ===
# 日志级别(debug|info|warn|error);slog JSON → stdout(systemd 收 journald)。
LOG_LEVEL=info
# 🔴 /metrics 独立 admin 端口:必须 loopback(127.0.0.1),绝不公网 / 不经 Caddy。
# 非 loopback 值启动期 fail-fast。
ADMIN_ADDR=127.0.0.1:9090
# OBS-4 告警:阈值检测保留(budget/上游熔断/磁盘/错误率),但只在管理后台页面显示当前
# firing 状态 + 最近触发时间,不外推(webhook/Telegram 已弃用)。绝不含 key/prompt/token/ip。

# SQLite 落盘路径(生产置于 ReadWritePaths 内)
GATEWAY_DB_PATH=anselm-gateway.db
