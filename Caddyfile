# Anselm Free-Tier Gateway — Caddy reverse proxy (蓝图 §10.2)
#
# Caddy 自动 HTTPS(ACME)。🔴 ACME HTTP-01 强制走 80 端口,服务器必须同时
# 开放 80 + 443(只开 443 会签证失败;或改 DNS-01 challenge 配 DNS 凭据)。
#
# {$SITE_DOMAIN} / {$GATEWAY_DOMAIN} / {$ACME_EMAIL} 由部署时注入(GitHub
# Actions secret 或从 api 子域推导,sed 替换)。
#
# ACME CA 兜底:Let's Encrypt 生产端点(acme-v02)在部分地区网络出口偶发被干扰
# (EOF / 500 / 503 + 空 body)。Caddy 默认同时启用 LE + ZeroSSL,任一抖动会自动
# fallback;ZeroSSL 自动 EAB 需要下面的全局 email。实测 ZeroSSL 这条路稳定签发。
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	root * /var/www/anselm-site
	file_server

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
}

{$GATEWAY_DOMAIN} {
	# 边缘请求体上限:与网关 MAX_BODY_BYTES(deploy.yml,5MiB)对齐,超限在边缘
	# 即拒(413),不进网关缓冲。改 MAX_BODY_BYTES 时同步改这里。
	request_body {
		max_size 5MiB
	}
	# request_body rejects before Go can render its canonical API envelope. Map
	# that one edge-generated error back onto the same public contract; all other
	# proxy/Caddy failures keep their native status and are not disguised as app
	# errors.
	handle_errors {
		@body_too_large expression {http.error.status_code} == 413
		header @body_too_large Content-Type "application/json"
		respond @body_too_large `{"error":{"code":"BAD_REQUEST","message":"invalid request body"}}` 400
	}

	# 流式 SSE:关闭缓冲,逐帧即时下发(否则 Caddy 会缓冲住流式 token)。
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}

	# 现代 TLS(自动管理证书;Caddy 默认 TLS 1.2+)。
	tls {
		protocols tls1.2 tls1.3
	}

	# 安全响应头(网关自身错误已归一化,这里只加传输层加固)。
	# X-Content-Type-Options: nosniff 关闭浏览器 MIME 嗅探——响应均为 JSON / SSE,
	# 嗅探只会引入跨类型混淆风险(SEC-3 传输层加固)。
	header {
		-Server
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
	}
}

# 管理后台(dashboard)不经 Caddy、不上公网:进程在 127.0.0.1:8081 自绑 loopback,仅当
# DASHBOARD_USER/PASSWORD 都配时才起。运维经 SSH 隧道访问(与 admin 9090 同款),例如:
#   ssh -L 8081:127.0.0.1:8081 <user>@<server>   然后浏览器开 http://localhost:8081
# 故意不暴露公网——一个裸登录页挂在新域名上易被扫描器/域名黑名单误判为钓鱼。
