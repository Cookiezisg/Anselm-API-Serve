# Anselm Free-Tier Gateway — Caddy reverse proxy (蓝图 §10.2)
#
# Caddy 自动 HTTPS(ACME)。🔴 ACME HTTP-01 强制走 80 端口,服务器必须同时
# 开放 80 + 443(只开 443 会签证失败;或改 DNS-01 challenge 配 DNS 凭据)。
#
# {$GATEWAY_DOMAIN} / {$ACME_EMAIL} 由部署时注入(GitHub Actions secret,sed 替换)。
#
# ACME CA 兜底:Let's Encrypt 生产端点(acme-v02)在部分地区网络出口偶发被干扰
# (EOF / 500 / 503 + 空 body)。Caddy 默认同时启用 LE + ZeroSSL,任一抖动会自动
# fallback;ZeroSSL 自动 EAB 需要下面的全局 email。实测 ZeroSSL 这条路稳定签发。

{
	email {$ACME_EMAIL}
}

{$GATEWAY_DOMAIN} {
	# 流式 SSE:关闭缓冲,逐帧即时下发(否则 Caddy 会缓冲住流式 token)。
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}

	# 现代 TLS(自动管理证书;Caddy 默认 TLS 1.2+)。
	tls {
		protocols tls1.2 tls1.3
	}

	# 安全响应头(网关自身错误已归一化,这里只加传输层加固)。
	# X-Content-Type-Options: nosniff 关闭浏览器 MIME 嗅探——响应均为 JSON / SSE,
	# 嗅探只会引入跨类型混淆风险(SEC-3 传输层加固)。
	header {
		-Server
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
	}
}

# 管理后台(dashboard):独立子域反代到进程内独立 loopback 监听 127.0.0.1:8081
# (与业务 8080 / admin 9090 物理隔离)。{$DASHBOARD_DOMAIN} 是与业务 api 平级的三级
# 子域 —— deploy 从 GATEWAY_DOMAIN 去掉首段拿根域再加 dashboard. 前缀(<api 域>
# → dashboard.<root>),而非四级的 dashboard.api.<root>;用户给 dashboard.<root>
# 加一条 DNS A 记录即可。仅当 DASHBOARD_USER/PASSWORD 都配时进程才起 8081;后台自身全
# 路由强制鉴权(bcrypt 登录 → session cookie → CSRF → 登录限流),除 /healthz 外无免鉴权
# 路由。Caddy 把真实 client IP append 到 XFF 末尾,后台据最右段做 per-IP 登录限流
# (只信 loopback peer 的 XFF,与业务 clientIP 同款)。
{$DASHBOARD_DOMAIN} {
	reverse_proxy 127.0.0.1:8081

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
	}
}
